# ==== ALIF CRM — Muhit o'zgaruvchilari namunasi ====
# Ushbu faylni `.env` deb nusxalab, qiymatlarni to'ldiring.
# `.env` faylini HECH QACHON repositoryga commit qilmang.

# --- Ma'lumotlar bazasi ---
# PostgreSQL ulanish satri (Neon, Railway yoki lokal Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Autentifikatsiya ---
# Sessiya cookie'larini imzolash uchun maxfiy kalit.
# Yaratish: `openssl rand -hex 32`
AUTH_SECRET="change-me-openssl-rand-hex-32"

# Ilova bazaviy manzili (cookie domeni, CAPI event_source_url uchun)
APP_URL="http://localhost:3000"

# --- Kiruvchi lead API ---
# Tashqi integratorlar (Make.com, Albato) shu kalit bilan lead yuboradi.
# Yaratish: `openssl rand -hex 24`
CRM_API_KEY="change-me-openssl-rand-hex-24"

# --- Meta Conversions API (CAPI) ---
# Bular ixtiyoriy default; asosiy sozlamalar CRM ichidagi Targetolog kabinetida saqlanadi.
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# --- Telegram bot ---
# @BotFather orqali olinadi
TELEGRAM_BOT_TOKEN=""
# Telegram webhook so'rovlarini tekshirish uchun maxfiy kalit
# Yaratish: `openssl rand -hex 16`
TELEGRAM_WEBHOOK_SECRET="change-me-openssl-rand-hex-16"

# Cron endpointlar himoyasi
CRON_SECRET="change-me-openssl-rand-hex-24"

# --- Cloudflare R2 (to'lov cheki/hujjat fayllari — ixtiyoriy) ---
# R2 dashboard -> bucket -> Settings -> S3 API dan Account ID olinadi.
# Manage R2 API Tokens -> Create API Token (Object Read & Write, shu bucketga cheklab).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
